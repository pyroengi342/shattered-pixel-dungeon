{
  "name": "@mcp-b/webmcp-types",
  "version": "2.2.0",
  "description": "Strict TypeScript type definitions for the WebMCP core API (navigator.modelContext)",
  "keywords": [
    "webmcp",
    "model-context",
    "navigator-modelcontext",
    "types",
    "typescript",
    "web-standard"
  ],
  "homepage": "https://docs.mcp-b.ai/packages/webmcp-types",
  "bugs": {
    "url": "https://github.com/WebMCP-org/npm-packages/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WebMCP-org/npm-packages.git",
    "directory": "packages/webmcp-types"
  },
  "license": "MIT",
  "author": "Alex Nahas",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts"
    }
  },
  "main": "",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src/common.ts",
    "src/index.ts",
    "src/json-schema.ts",
    "src/model-context.ts",
    "src/tool.ts"
  ],
  "devDependencies": {
    "@vitest/browser": "^4.0.18",
    "@vitest/browser-playwright": "^4.0.18",
    "@vitest/coverage-v8": "^4.0.18",
    "playwright": "^1.58.0",
    "typescript": "^5.8.3",
    "vitest": "^4.0.18"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "biome check --write .",
    "clean": "rm -rf dist .turbo",
    "format": "biome format --write .",
    "lint": "biome lint --write .",
    "publish:dry": "pnpm publish --access public --dry-run",
    "publish:npm": "pnpm publish --access public",
    "test": "vitest run && pnpm run test:conformance",
    "test:browser": "vitest run --config vitest.browser.config.ts --browser.headless",
    "test:browser:ui": "vitest --config vitest.browser.config.ts --browser",
    "test:conformance": "vitest run --config vitest.conformance.config.ts",
    "typecheck": "tsc --noEmit && vitest run --typecheck --silent"
  }
}